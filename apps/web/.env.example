# 网关基础 WebSocket 地址。留空时使用当前站点地址，并由 Vite 反向代理到 mesh.xiaonext.com。
VITE_GATEWAY_WS_URL=

# 批量上传总目标上行带宽，单位 Mbps。用于按并发数自动计算每个文件的数据块大小。
VITE_BATCH_UPLOAD_BANDWIDTH_MBPS=200

# 每个数据块对应的目标传输时间窗口，单位毫秒。
VITE_BATCH_UPLOAD_CHUNK_INTERVAL_MS=150

# 自动计算后的数据块上下限，单位 KiB。
VITE_BATCH_UPLOAD_MIN_CHUNK_KIB=2048
VITE_BATCH_UPLOAD_MAX_CHUNK_KIB=10240