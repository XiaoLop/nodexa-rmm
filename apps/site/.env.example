# Public base URL used by canonical links, Open Graph metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional console URL used when no contact details are configured.
NEXT_PUBLIC_CONSOLE_URL=https://console.example.com

# Public contact details shown on the product site.
# These values are intentionally public and are bundled into the browser output.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_TELEGRAM=@your-telegram-id
NEXT_PUBLIC_CONTACT_WECHAT=your-wechat-id