# Gateway HTTP 监听端口。
PORT=3000

# MeshCentral 服务端 Origin。生产环境必须使用 HTTPS，且不能包含路径、查询参数或凭据。
MESH_CENTRAL_BASE_URL=https://mesh.example.com

# MeshCentral 域路径，例如 /、/customer-a/。Gateway 会自动补齐首尾斜杠。
MESH_CENTRAL_DOMAIN_PATH=/

# 浏览器访问 Web 控制台的公开 Origin，用于校验 WebSocket Origin。
# 生产环境必须设置为实际 HTTPS Origin，例如 https://console.example.com。
GATEWAY_PUBLIC_ORIGIN=http://localhost:5173

# 信任的反向代理跳数。直连使用 0；经过一层 Nginx 或 Ingress 时通常使用 1。
GATEWAY_TRUST_PROXY=0

# HTTP 上游请求总超时，单位为毫秒。
GATEWAY_UPSTREAM_TIMEOUT_MS=10000

# 登录控制通道验证超时，单位为毫秒，供结构化登录验证阶段使用。
GATEWAY_LOGIN_VALIDATION_TIMEOUT_MS=5000

# WebSocket 空闲超时，单位为毫秒；0 表示不由 Gateway 主动设置空闲超时。
GATEWAY_WS_IDLE_TIMEOUT_MS=0

# 是否验证 MeshCentral TLS 证书。生产环境禁止设置为 false。
GATEWAY_TLS_REJECT_UNAUTHORIZED=true

# 是否允许缺少 Origin 的 WebSocket 请求。仅建议本地开发或非浏览器测试启用。
GATEWAY_ALLOW_MISSING_ORIGIN=true