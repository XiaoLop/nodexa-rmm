{
    "$schema": "https://raw.githubusercontent.com/Ylianst/MeshCentral/master/meshcentral-config-schema.json",
    "settings": {
        "_cert": "mesh.example.com",
        "port": 443,
        "aliasPort": 443,
        "redirPort": 80,
        "dataPath": "/var/lib/meshcentral/data",
        "filesPath": "/var/lib/meshcentral/files",
        "WANonly": true,
        "mongoDb": "mongodb://meshcentral:development-password@mongodb:27017/meshcentral?authSource=admin",
        "mongoDbName": "meshcentral",
        "selfUpdate": false,
        "compression": true,
        "wsCompression": false,
        "agentWsCompression": false,
        "webRTC": true,
        "webrtcConfig": {
            "iceServers": [
                {
                    "urls": "stun:stun.qq.com:3478"
                },
                {
                    "urls": "stun:stun.baidu.com:3478"
                },
                {
                    "urls": "stun:stun.aliyun.com:3478"
                },
                {
                    "urls": "stun:stun.cloudflare.com:3478"
                },
                {
                    "urls": "stun:stun.l.google.com:19302"
                }
            ]
        },
        "agentPing": 30,
        "agentPong": 60,
        "autoBackup": {
            "backupIntervalHours": 24,
            "keepLastDaysBackup": 7,
            "backupPath": "/var/lib/meshcentral/backups"
        },
        "plugins": {
            "enabled": true,
            "list": [
                "jsonauth",
                "utils"
            ]
        }
    },
    "domains": {
        "": {
            "title": "Mesh Console Dev",
            "title2": "Local development",
            "newAccounts": false,
            "geoLocation": true,
            "ipLocation": true,
            "sessionRecording": {
                "filepath": "/var/lib/meshcentral/recordings",
                "protocols": []
            },
            "agentFileInfo": {
                "icon": "favicon.ico",
                "fileDescription": "Nodexa RMM Remote Support Client",
                "fileVersion": "1.0.0.0",
                "internalName": "NodexaRMM",
                "legalCopyright": "Copyright Nodexa",
                "originalFilename": "nodexa-rmm-agent.exe",
                "productName": "Nodexa RMM Agent",
                "productVersion": "v1.0.0.0"
            },
            "agentCustomization": {
                "displayName": "Nodexa RMM Agent",
                "description": "Nodexa RMM device management and remote support service",
                "companyName": "Nodexa",
                "serviceName": "nodexarmmagent",
                "installText": "Install the Nodexa RMM remote management service",
                "image": "logo.png",
                "fileName": "nodexa-rmm-agent",
                "foregroundColor": "#FFFFFF",
                "backgroundColor": "#2563EB"
            }
        }
    }
}