# Docker Compose 项目名，用于容器、网络和命名卷前缀。
COMPOSE_PROJECT_NAME=mesh-console

# 要挂载的全局配置文件。路径相对于运行 docker compose 命令的当前目录。
APP_CONFIG_FILE=./deploy/config/development.yaml

# 项目镜像版本。生产环境应使用不可变版本号或镜像摘要。
IMAGE_TAG=0.1.0

# 生产镜像地址。开发基础设施 Compose 不使用这些值。
CONFIG_IMAGE=mesh-console-config
WEB_IMAGE=mesh-console-web
GATEWAY_IMAGE=mesh-console-gateway
MESHCENTRAL_IMAGE=mesh-console-meshcentral

# 本地 MongoDB 对宿主机暴露的端口。
MONGODB_PORT=27017

# Secret 文件路径。生产环境应改为受控路径或外部 Secret 管理机制。
MONGODB_ROOT_USERNAME_FILE=./deploy/secrets/mongodb-root-username
MONGODB_ROOT_PASSWORD_FILE=./deploy/secrets/mongodb-root-password
MESHCENTRAL_MONGODB_URL_FILE=./deploy/secrets/meshcentral-mongodb-url
MESHCENTRAL_SESSION_KEY_FILE=./deploy/secrets/meshcentral-session-key
MESHCENTRAL_DB_ENCRYPTION_KEY_FILE=./deploy/secrets/meshcentral-db-encryption-key
MESHCENTRAL_BACKUP_PASSWORD_FILE=./deploy/secrets/meshcentral-backup-password
TLS_CERTIFICATE_FILE=./deploy/secrets/tls-certificate.pem
TLS_PRIVATE_KEY_FILE=./deploy/secrets/tls-private-key.pem