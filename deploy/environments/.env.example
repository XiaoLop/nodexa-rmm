# 复制到部署目录根部并命名为 .env.production，不要提交生产凭据。

# MongoDB 首次初始化密码；MeshCentral 使用同一管理员账号连接数据库。
# 填写原始强密码，无需 URL 编码；单引号可避免 $ 被 Compose 插值。
# 仅对空数据库卷生效，已有数据库改密需先在 MongoDB 中执行。
MONGODB_ROOT_PASSWORD='ybyy5vm8hXf3jdQSjcJd'

WEB_IMAGE=nodexa-web:local
# 可选：默认读取 ./config/config.meshcental.prod.yaml。
# MESHCENTRAL_CONFIG_FILE=./config/config.meshcental.prod.yaml

# 可选覆盖项；使用默认值时无需取消注释。
# MONGODB_ROOT_USERNAME=meshcentral
# MESHCENTRAL_IMAGE=nodexa-rmm:production