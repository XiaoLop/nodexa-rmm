{
  "name": "nodexarmm-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @meshcentral/web dev",
    "build:web": "pnpm --filter @meshcentral/web build",
    "dev:site": "pnpm --filter @meshcentral/site dev",
    "dev:app": "pnpm --filter @meshcentral/app start",
    "build:web:img": "docker build -f apps/web/Dockerfile -t nodexa-web:local .",
    "build:meshcentral:img": "docker build -f apps/meshcentral/Dockerfile -t nodexa-rmm:local .",
    "build:nodexa:img": "pnpm build:web:img && pnpm build:meshcentral:img",
    "run:nodexa": "docker compose --env-file deploy/local/.env -f deploy/local/compose.nodexa.dev.yaml up -d",
    "prod:meshcentral:build": "docker build -f apps/meshcentral/Dockerfile -t nodexa-rmm:production .",
    "prod:meshcentral:save": "docker save -o ./deploy/generated/nodexa-rmm-production.tar nodexa-rmm:production",
    "prod:meshcentral:package": "pnpm prod:meshcentral:build && pnpm prod:meshcentral:save",
    "plugins:build": "pnpm --filter @meshcentral/plugins build",
    "plugins:typecheck": "pnpm --filter @meshcentral/plugins typecheck",
    "dev:mcp": "pnpm --filter @meshcentral/mcp dev",
    "build:mcp": "pnpm --filter @meshcentral/mcp build",
    "mcp:login": "pnpm --filter @meshcentral/mcp login",
    "control": "tsx --env-file-if-exists=.env test/control.test.ts",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "ws": "catalog:"
  }
}
