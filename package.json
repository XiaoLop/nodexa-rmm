{
  "name": "meshcentral-client-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @meshcentral/web dev",
    "dev:site": "pnpm --filter @meshcentral/site dev",
    "dev:app": "pnpm --filter @meshcentral/app start",
    "dev:gateway": "pnpm --filter @meshcentral/gateway dev",
    "dev:meshcentral:start": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml up -d meshcentral",
    "dev:meshcentral:build": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml build meshcentral",
    "dev:meshcentral:rebuild": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml up -d --build meshcentral",
    "dev:meshcentral:restart": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml restart meshcentral",
    "dev:meshcentral:stop": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml stop meshcentral",
    "dev:meshcentral:down": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml down",
    "dev:meshcentral:status": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml ps",
    "dev:meshcentral:logs": "docker compose -f deploy/compose/compose.meshcentral.dev.yaml logs -f meshcentral",
    "dev:meshcentral:restart-with-plugins": "pnpm dev:meshcentral:rebuild",
    "prod:meshcentral:build": "docker build -f apps/meshcentral/Dockerfile --build-arg MESHCENTRAL_VERSION=1.1.54 -t nodexa-rmm:production .",
    "prod:meshcentral:save": "docker save -o nodexa-rmm-production.tar nodexa-rmm:production",
    "prod:meshcentral:package": "pnpm prod:meshcentral:build && pnpm prod:meshcentral:save",
    "plugins:build": "pnpm --filter @meshcentral/plugins build",
    "plugins:typecheck": "pnpm --filter @meshcentral/plugins typecheck",
    "control": "tsx --env-file-if-exists=.env test/control.test.ts",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.21.3"
  }
}
