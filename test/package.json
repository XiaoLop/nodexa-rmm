{
  "name": "@meshcentral/test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node --env-file=.env ./node_modules/vitest/vitest.mjs run manual/terminal-data.capture.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@meshcentral/control-client": "workspace:*",
    "@meshcentral/relay": "workspace:*",
    "@meshcentral/shared-state": "workspace:*",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "vitest": "^4.1.0"
  }
}