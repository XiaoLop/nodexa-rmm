{
  "name": "@meshcentral/test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "pnpm capture:terminal",
    "capture:terminal": "node --env-file=.env ./node_modules/vitest/vitest.mjs run manual/terminal-data.capture.test.ts --reporter=verbose",
    "capture:desktop": "node --env-file=.env ./node_modules/vitest/vitest.mjs run manual/desktop-data.capture.test.ts --reporter=verbose",
    "test:desktop-captures": "vitest run desktop"
  },
  "dependencies": {
    "@meshcentral/control-client": "workspace:*",
    "@meshcentral/relay": "workspace:*",
    "@meshcentral/shared-state": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}