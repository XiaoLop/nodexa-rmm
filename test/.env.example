RUN_MANUAL_INTEGRATION=0
CAPTURE_SCENARIO=terminal
DESKTOP_CAPTURE_SCENARIO=connection-basic

GATEWAY_WS_URL=wss://meshcentral.example.test/control
MESHRELAY_URL=wss://meshcentral.example.test/meshrelay.ashx
# 可选：Web 登录流程产生的 URL 编码 x-meshauth。不要提交真实值。
GATEWAY_MESHAUTH=
# 可选：网关使用短期 Token 认证时提供。不要提交真实值。
GATEWAY_ACCESS_TOKEN=

# terminal 和 relaylog 场景使用具有终端权限的设备。
MESH_DEVICE_ID=
# permission-denied 场景使用无终端权限账户可见的目标设备。
MESH_DENIED_DEVICE_ID=

MESH_VERSION=
MESH_AGENT_VERSION=
MESH_DEVICE_PLATFORM=windows
MESH_SHELL=cmd

TERMINAL_COLS=120
TERMINAL_ROWS=30
MANUAL_CONNECTION_TIMEOUT_MS=15000
MANUAL_HANDSHAKE_TIMEOUT_MS=15000
MANUAL_EVENT_WINDOW_MS=10000
MANUAL_RELAYLOG_WAIT_MS=5000
MANUAL_RTT_INTERVAL_MS=10000
MANUAL_TEST_TIMEOUT_MS=60000
MANUAL_CAPTURE_DIR=captures

# 桌面采集默认只发送协议号 2。动作场景使用固定、无敏感数据的参数。
DESKTOP_ACTION_DELAY_MS=2000
DESKTOP_ACTION_X=320
DESKTOP_ACTION_Y=240
DESKTOP_KEY_CODE=65
DESKTOP_UNICODE_CHARACTER=中
DESKTOP_DISPLAY_ID=0
# 仅当已知测试图需要固定数量图块即可完整覆盖桌面时设置；0 表示不自动宣告 desktop-ready。
DESKTOP_READY_AFTER_TILES=0

# 默认留空。仅在测试设备上发送无敏感、无副作用的输入，例如 ver\r。
MANUAL_TERMINAL_INPUT=
