{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerWarningsMessage",
  "type": "object",
  "required": [
    "action",
    "warnings"
  ],
  "properties": {
    "action": {
      "type": "string",
      "const": "serverwarnings"
    },
    "warnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id",
              "msg"
            ],
            "properties": {
              "id": {
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "msg": {
                "type": "string"
              },
              "args": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
